{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "client/dist",
    "functions": {
        "api/index.js": {
            "includeFiles": "server/**"
        }
    },
    "rewrites": [
        { "source": "/api/:path*", "destination": "/api?path=:path*" },
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}